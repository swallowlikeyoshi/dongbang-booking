AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
ADMIN_EMAIL=you@example.com,other@example.com
# Auth.js(next-auth v5) 공개 URL. 로컬=http://localhost:3000, 배포=실제 https 도메인
AUTH_URL=http://localhost:3000
# 시간대 (컨테이너 이미지에 기본 Asia/Seoul이 구워져 있음)
TZ=Asia/Seoul
DATABASE_PATH=./data/dongbang.db

# 스터디 시간 기록 — 장비별 시크릿. 형식: 방번호:시크릿,방번호:시크릿
# 방번호는 rooms 테이블의 id (1=공학실습동 24214, 2=학생회관 03324)
# 주의: 파서가 ","로 쌍을 나누고 ":"로 방번호/시크릿을 나누므로 시크릿 값
# 자체에는 쉼표(,)를 넣지 말 것 — 콜론(:)도 여러 개면 어디서 나뉘는지
# 모호해지니 피할 것. 또한 시크릿은 QR 스캔 URL에 그대로 실려 QR 버전 4
# 크기(코드 길이) 예산에 들어간다 — 전체 스캔 URL이 약 56자를 넘으면 QR이
# 더 촘촘해져 스캔 신뢰도가 떨어지므로 시크릿을 과도하게 길게 잡지 말 것.
ATTENDANCE_DEVICE_SECRETS=1:change-me-room1,2:change-me-room2

# 학번 원장 CSV 경로 (기본 ./data/roster.csv). repo 에 커밋하지 않는다.
ROSTER_CSV=./data/roster.csv
